<Window x:Class="mazanabe.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard" Height="700" Width="1000">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection Test Panel -->
        <GroupBox Grid.Row="0" Header="Connection Test" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTestConnection" Content="Test Connection" Width="120" Height="30" Margin="5" Click="BtnTestConnection_Click"/>
                <TextBlock x:Name="txtConnectionStatus" Margin="10" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- Database Operations Tabs -->
        <TabControl Grid.Row="1">
            <!-- Users Tab -->
            <TabItem Header="Users">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- User Input Form -->
                    <GroupBox Grid.Row="0" Header="Add User" Margin="10">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" Margin="5"/>
                            <TextBox x:Name="txtUsername" Grid.Row="0" Grid.Column="1" Margin="5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" Margin="5"/>
                            <TextBox x:Name="txtEmail" Grid.Row="1" Grid.Column="1" Margin="5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" Margin="5"/>
                            <PasswordBox x:Name="txtPassword" Grid.Row="2" Grid.Column="1" Margin="5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="User Type:" Margin="5"/>
                            <ComboBox x:Name="userTypeComboBox" Grid.Row="3" Grid.Column="1" Margin="5">
                                <ComboBoxItem Content="Premium"/>
                                <ComboBoxItem Content="Freemium"/>
                            </ComboBox>

                            <Button x:Name="btnAddUser" Grid.Row="4" Grid.Column="1" 
                                    Content="Add User" HorizontalAlignment="Right" Width="100" Margin="5" Click="BtnAddUser_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- Users DataGrid -->
                    <DataGrid x:Name="usersDataGrid" Grid.Row="1" Margin="10" 
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="Auto"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="User Type" Binding="{Binding UserType}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- User Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">

                        <Button x:Name="btnRemoveUser" Content="Remove User" Width="150" 
                                Click="BtnRemoveUser_Click"/>
                        <Button x:Name="btnEditUser" Content="Edit User" Width="150" 
                         Click="BtnEditUser_Click" />

                        <TextBlock x:Name="userCountTextBlock" Text="Total Users: 0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Movie Tab -->
            <TabItem Header="Movies">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Movie Input Form - Split into two columns for better organization -->
                    <GroupBox Grid.Column="0" Header="Movie Details" Margin="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Basic Movie Information -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Movie Title:" Margin="5"/>
                                <TextBox x:Name="txtMovieTitle" Grid.Row="0" Grid.Column="1" Margin="5" 
                                        GotFocus="txtMovieTitle_GotFocus" LostFocus="txtMovieTitle_LostFocus"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Director:" Margin="5"/>
                                <TextBox x:Name="txtDirector" Grid.Row="1" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Release Date:" Margin="5"/>
                                <TextBox x:Name="txtReleaseDate" Grid.Row="2" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Genre:" Margin="5"/>
                                <TextBox x:Name="txtGenre" Grid.Row="3" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Language:" Margin="5"/>
                                <TextBox x:Name="txtLanguage" Grid.Row="4" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Country:" Margin="5"/>
                                <TextBox x:Name="txtCountry" Grid.Row="5" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Duration (Minutes):" Margin="5"/>
                                <TextBox x:Name="txtDuration" Grid.Row="6" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Main Character:" Margin="5"/>
                                <TextBox x:Name="txtMainCharacter" Grid.Row="7" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Plot Summary:" Margin="5"/>
                                <TextBox x:Name="txtPlotSummary" Grid.Row="8" Grid.Column="1" Margin="5" 
                                        TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
                            </Grid>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- Additional Movie Information -->
                    <GroupBox Grid.Column="1" Header="Additional Information" Margin="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="IMDb Rating:" Margin="5"/>
                                <TextBox x:Name="txtIMDbRating" Grid.Row="0" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Box Office Gross:" Margin="5"/>
                                <TextBox x:Name="txtBoxOfficeGross" Grid.Row="1" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Budget:" Margin="5"/>
                                <TextBox x:Name="txtBudget" Grid.Row="2" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Production Company:" Margin="5"/>
                                <TextBox x:Name="txtProductionCompany" Grid.Row="3" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Awards:" Margin="5"/>
                                <TextBox x:Name="txtAwards" Grid.Row="4" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Streaming Platform:" Margin="5"/>
                                <TextBox x:Name="txtStreamingPlatform" Grid.Row="5" Grid.Column="1" Margin="5"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Movie Type:" Margin="5"/>
                                <ComboBox x:Name="cmbMovieType" Grid.Row="6" Grid.Column="1" Margin="5">
                                    <ComboBoxItem Content="Action"/>
                                    <ComboBoxItem Content="Drama"/>
                                    <ComboBoxItem Content="Comedy"/>
                                    <ComboBoxItem Content="Thriller"/>
                                    <ComboBoxItem Content="Horror"/>
                                    <ComboBoxItem Content="Sci-Fi"/>
                                </ComboBox>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Age Group:" Margin="5"/>
                                <ComboBox x:Name="cmbAgeGroup" Grid.Row="7" Grid.Column="1" Margin="5">
                                    <ComboBoxItem Content="All Ages"/>
                                    <ComboBoxItem Content="Kids"/>
                                    <ComboBoxItem Content="Teens"/>
                                    <ComboBoxItem Content="Adults"/>
                                </ComboBox>

                                <Button x:Name="btnAddMovie" Content="Add Movie" Grid.Row="8" Grid.Column="1" 
                                       HorizontalAlignment="Right" Width="100" Margin="5" Click="BtnAddMovie_Click"/>
                            </Grid>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- Movies DataGrid to display existing movies -->
                    <DataGrid x:Name="moviesDataGrid" Grid.Row="1" Grid.ColumnSpan="2" Margin="10"
                             AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="Auto"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Director" Binding="{Binding Director}" Width="*"/>
                            <DataGridTextColumn Header="Release Year" Binding="{Binding ReleaseYear}" Width="Auto"/>
                            <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="*"/>
                            <DataGridTextColumn Header="Rating" Binding="{Binding IMDbRating}" Width="Auto"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Add this below the existing DataGrid in the Movies TabItem -->
                    <!-- Find this line: <DataGrid x:Name="moviesDataGrid" Grid.Row="1" Grid.ColumnSpan="2" Margin="10" ... > -->
                    <!-- And add this code after the closing </DataGrid> -->

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="10,210,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Movie count display -->
                        <TextBlock x:Name="movieCountTextBlock" Grid.Column="0" 
               Text="Total Movies: 0" VerticalAlignment="Center"
               FontWeight="Bold"/>

                        <!-- Action buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnEditMovie" Content="Edit Movie" Width="100" Margin="0,0,10,0"
                Click="BtnEditMovie_Click"/>
                            <Button x:Name="btnRemoveMovie" Content="Remove Movie" Width="120"
                Click="BtnRemoveMovie_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>