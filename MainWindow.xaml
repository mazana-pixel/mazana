<Window x:Class="mazanabe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mazanabe"
        mc:Ignorable="d"
        Title="Movie Dashboard" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4B0082" Offset="0"/>
            <GradientStop Color="#6A0DAD" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6A0DAD" Offset="0"/>
            <GradientStop Color="#4B0082" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="MovieItemStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,2,0,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="12,8,12,12"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="10" Opacity="0.5" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuestionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,10,0,8"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="ScrollableListStyle" TargetType="ListView">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MaxHeight" Value="150"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="MovieListStyle" TargetType="ListView">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style x:Key="PointsDisplayStyle" TargetType="Border">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.5" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MovieTemplate">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="#333333" CornerRadius="20" Margin="0,0,10,0">
                    <TextBlock Text="🎬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#E0E0E0"/>
                    <TextBlock Text="{Binding Year}" FontSize="12" Foreground="#B0B0B0" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RecommendationTemplate">
            <Border Background="#333333" CornerRadius="8" Padding="12" Margin="0,0,0,12" Width="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="50" Height="70" Background="#444444" CornerRadius="5" Margin="0,0,12,0">
                        <TextBlock Text="🎬" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="#E0E0E0"/>
                        <TextBlock Text="{Binding Year}" FontSize="13" Foreground="#B0B0B0" Margin="0,2,0,5"/>
                        <TextBlock Text="{Binding Genre}" FontSize="12" Foreground="#A0A0A0"/>
                        <TextBlock Text="{Binding Rating}" FontSize="12" Foreground="#FFD700" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                        <Button Content="+ Favorite" Style="{StaticResource SmallActionButtonStyle}" Width="80" Margin="0,0,0,8" Click="AddToFavorites_Click"/>
                        <Button Content="+ Watchlist" Style="{StaticResource SmallActionButtonStyle}" Width="80" Click="AddToWatchlist_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="CINEMA PULSE" FontSize="28" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI Light"/>
                    <TextBlock Text="Your ultimate movie companion" Foreground="#D0D0D0" FontSize="15" Margin="0,5,0,0" FontFamily="Segoe UI Light"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource PointsDisplayStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MY POINTS: " FontSize="14" Foreground="#B0B0B0"/>
                            <TextBlock x:Name="UserPointsDisplay" Text="250" FontSize="14" FontWeight="Bold" Foreground="#FFD700" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Admin Dashboard" Width="150" Height="35" 
                            Style="{StaticResource ModernButtonStyle}" Click="GoToAdminDashboard_Click" Margin="15,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#121212">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource SectionBorderStyle}" Background="#1E1E1E">
                    <StackPanel Margin="18">
                        <TextBlock Text="MY FAVORITES" Style="{StaticResource SectionHeaderStyle}"/>
                        <ListView x:Name="FavoritesListView" Style="{StaticResource MovieListStyle}" 
                                  ItemTemplate="{StaticResource MovieTemplate}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource SectionBorderStyle}" Background="#1E1E1E">
                    <StackPanel Margin="18">
                        <TextBlock Text="MY WATCHLIST" Style="{StaticResource SectionHeaderStyle}"/>
                        <ListView x:Name="WatchlistListView" Style="{StaticResource MovieListStyle}" 
                                  ItemTemplate="{StaticResource MovieTemplate}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource SectionBorderStyle}" Background="#1E1E1E">
                    <StackPanel Margin="18">
                        <TextBlock Text="Finding My Type" Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock Text="What type of movies do you enjoy?" Style="{StaticResource QuestionTextStyle}"/>
                        <ListView x:Name="MovieTypeList" Style="{StaticResource ScrollableListStyle}">
                            <ListViewItem>
                                <CheckBox Content="Action &amp; Adventure" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                            <ListViewItem>
                                <CheckBox Content="Drama" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                            <ListViewItem>
                                <CheckBox Content="Sci-Fi" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                            <ListViewItem>
                                <CheckBox Content="Comedy" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                            <ListViewItem>
                                <CheckBox Content="Horror" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                            <ListViewItem>
                                <CheckBox Content="Romance" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                            <ListViewItem>
                                <CheckBox Content="Thriller" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                            <ListViewItem>
                                <CheckBox Content="Animation" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                            <ListViewItem>
                                <CheckBox Content="Documentary" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                            <ListViewItem>
                                <CheckBox Content="Anime" Foreground="#E0E0E0" FontSize="14" Margin="5"/>
                            </ListViewItem>
                        </ListView>

                        <TextBlock Text="What era of films do you prefer?" Style="{StaticResource QuestionTextStyle}"/>
                        <ListView x:Name="MovieEraList" Style="{StaticResource ScrollableListStyle}">
                            <ListViewItem>
                                <RadioButton Content="Classic (Pre-1970s)" Foreground="#E0E0E0" FontSize="14" Margin="5" GroupName="EraGroup"/>
                            </ListViewItem>
                            <ListViewItem>
                                <RadioButton Content="Retro (1970s-1990s)" Foreground="#E0E0E0" FontSize="14" Margin="5" GroupName="EraGroup"/>
                            </ListViewItem>
                            <ListViewItem>
                                <RadioButton Content="Modern (2000s-2010s)" Foreground="#E0E0E0" FontSize="14" Margin="5" GroupName="EraGroup"/>
                            </ListViewItem>
                            <ListViewItem>
                                <RadioButton Content="Contemporary (2020s+)" Foreground="#E0E0E0" FontSize="14" Margin="5" GroupName="EraGroup"/>
                            </ListViewItem>
                            <ListViewItem>
                                <RadioButton Content="All Eras" Foreground="#E0E0E0" FontSize="14" Margin="5" GroupName="EraGroup" IsChecked="True"/>
                            </ListViewItem>
                        </ListView>

                        <TextBlock Text="How do you rate the importance of IMDb scores?" Style="{StaticResource QuestionTextStyle}"/>
                        <ComboBox x:Name="RatingImportanceCombo" Margin="0,5,0,15" Padding="8,5" Background="#333333" Foreground="#E04" BorderBrush="#444444">
                            <ComboBoxItem Content="Very Important (8.0+)" IsSelected="True"/>
                            <ComboBoxItem Content="Somewhat Important (7.0+)"/>
                            <ComboBoxItem Content="Not Important"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource SectionBorderStyle}" Background="#1E1E1E">
                    <StackPanel Margin="18">
                        <TextBlock Text="RECOMMENDED FOR YOU" Style="{StaticResource SectionHeaderStyle}"/>

                        <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"
                                      Background="#222222" Padding="15" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel x:Name="RecommendationsPanel">
                                <TextBlock x:Name="RecommendationBoxPlaceholder" 
                                           Text="Complete your preferences and click 'Generate Recommendations' to see personalized movie suggestions."
                                           TextWrapping="Wrap" Foreground="#E0E0E0" Margin="0,0,0,15" FontSize="14"/>

                                <!-- Sample recommendation items - will be populated programmatically -->
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RecommendationTemplate}" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Content="Generate Recommendations" Width="220" HorizontalAlignment="Center"
                                Style="{StaticResource ModernButtonStyle}" Click="GenerateButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource SectionBorderStyle}" Background="#1E1E1E">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>