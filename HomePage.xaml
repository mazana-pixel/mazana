<Window x:Class="MovieRecommenderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MovieRecommenderApp"
        mc:Ignorable="d"
        Title="Movie Finder" Height="600" Width="800"
        Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Simple Header -->
        <Grid Grid.Row="0" Background="#222222">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title -->
            <TextBlock Grid.Column="0" 
                       Text="MOVIE FINDER" 
                       Foreground="#E50914" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

            <!-- Authentication Buttons -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        Margin="0,0,20,0">
                <Button Content="Sign In" 
                        Foreground="White" 
                        Background="#E50914"
                        Width="80" 
                        Height="30" 
                        Margin="0,0,10,0"
                        Click="SignInButton_Click"/>
                <Button Content="Sign Up" 
                        Foreground="White" 
                        Background="Transparent" 
                        BorderBrush="#E50914"
                        BorderThickness="1"
                        Width="80" 
                        Height="30"
                        Click="SignUpButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Hero Banner -->
                    <RowDefinition Height="Auto"/>
                    <!-- Featured Movies -->
                    <RowDefinition Height="Auto"/>
                    <!-- Categories -->
                </Grid.RowDefinitions>

                <!-- Simple Hero Banner -->
                <Grid Grid.Row="0" 
                      Background="#333333" 
                      Height="200" 
                      Margin="20,20,20,30">
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center">
                        <TextBlock Text="Find Your Next Favorite Movie" 
                                   Foreground="White" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   TextAlignment="Center"/>
                        <TextBlock Text="Personalized recommendations just for you" 
                                   Foreground="#CCCCCC" 
                                   FontSize="16" 
                                   TextAlignment="Center" 
                                   Margin="0,10,0,20"/>
                        <Button Content="Explore Movies" 
                                Background="#E50914" 
                                Foreground="White" 
                                Padding="15,8" 
                                Click="ExploreButton_Click"/>
                    </StackPanel>
                </Grid>

               

               
            </Grid>
        </ScrollViewer>

        <!-- Simple Footer -->
        <Grid Grid.Row="2" Background="#222222"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Contact Info -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Contact: info@moviefinder.com" 
                           Foreground="#CCCCCC" 
                           FontSize="12"/>
                <TextBlock Text="Phone: (555) 123-4567" 
                           Foreground="#CCCCCC" 
                           FontSize="12"/>
            </StackPanel>

            <!-- Copyright Info -->
            <TextBlock Grid.Column="1" 
                       Text="© 2025 Movie Finder" 
                       Foreground="#999999" 
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>