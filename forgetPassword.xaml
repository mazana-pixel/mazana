<Page x:Class="mazanabe.ForgotPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Forgot Password" Background="#121212">

    <Page.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4B0082" Offset="0"/>
            <GradientStop Color="#6A0DAD" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6A0DAD" Offset="0"/>
            <GradientStop Color="#4B0082" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fixed TextBox Style to ensure text is visible -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#6A0DAD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="CINEMA PULSE" FontSize="28" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI Light"/>
                    <TextBlock Text="Reset your password" Foreground="#D0D0D0" FontSize="15" Margin="0,5,0,0" FontFamily="Segoe UI Light"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Forgot Password Form -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="15" Margin="20">
            <Grid Margin="30">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                    <TextBlock Text="FORGOT PASSWORD" FontSize="24" FontWeight="Bold" Foreground="#E0E0E0" 
                               FontFamily="Segoe UI" TextAlignment="Center" Margin="0,0,0,30"/>

                    <TextBlock Text="Enter your email address below and we'll send you instructions to reset your password." 
                               Foreground="#B0B0B0" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>

                    <!-- Email -->
                    <TextBlock Text="Email" Style="{StaticResource TextLabelStyle}"/>
                    <TextBox x:Name="EmailTextBox" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,25"/>

                    <!-- Reset Password Button -->
                    <Button Content="Reset Password" Height="45" Style="{StaticResource ModernButtonStyle}" 
                            Click="ResetPasswordButton_Click" Margin="0,10,0,20"/>

                    <!-- Back to Sign In -->
                    <TextBlock Text="Back to Sign In" HorizontalAlignment="Center" Foreground="#6A0DAD" 
                               FontSize="14" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonUp="BackToSignIn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>